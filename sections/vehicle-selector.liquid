{%- liquid
  assign contact_url = section.settings.contact_url
  if contact_url == blank
    assign contact_url = routes.root_url | append: '/pages/kontakt' | replace: '//', '/'
  endif

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
-%}

<script
  src="{{ 'vehicle-selector.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-testid="vehicle-selector-{{ section.id }}"
>
  <vehicle-selector-component
    class="vehicle-selector"
    data-contact-url="{{ contact_url }}"
  >
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="vehicle-selector__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="vehicle-selector__heading h3">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="vehicle-selector__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <p
      class="vehicle-selector__empty"
      ref="empty"
      hidden
    >
      {{ 'vehicle_selector.empty' | t }}
    </p>

    <div
      class="vehicle-selector__summary"
      ref="summary"
      hidden
    >
      <p class="vehicle-selector__summary-text">
        {{ 'vehicle_selector.your_vehicle' | t }}
        <strong ref="summaryText"></strong>
      </p>
      <button
        type="button"
        class="button-unstyled vehicle-selector__change"
        on:click="/editVehicle"
      >
        {{ 'vehicle_selector.change_vehicle' | t }}
      </button>
    </div>

    <form
      class="vehicle-selector__form"
      ref="form"
      on:submit="/handleSubmit"
      novalidate
    >
      <div class="vehicle-selector__fields">
        <div class="vehicle-selector__field">
          <label
            class="vehicle-selector__label"
            for="VehicleSelectorBrand-{{ section.id }}"
          >
            {{- 'vehicle_selector.brand' | t -}}
          </label>
          <select
            id="VehicleSelectorBrand-{{ section.id }}"
            class="field__input vehicle-selector__select"
            name="brand"
            ref="brand"
            on:change="/handleBrandChange"
          >
            <option value="">{{ 'vehicle_selector.choose_brand' | t }}</option>
          </select>
        </div>

        <div class="vehicle-selector__field">
          <label
            class="vehicle-selector__label"
            for="VehicleSelectorModel-{{ section.id }}"
          >
            {{- 'vehicle_selector.model' | t -}}
          </label>
          <select
            id="VehicleSelectorModel-{{ section.id }}"
            class="field__input vehicle-selector__select"
            name="model"
            ref="model"
            on:change="/handleModelChange"
            disabled
          >
            <option value="">{{ 'vehicle_selector.choose_model' | t }}</option>
          </select>
        </div>

        <div class="vehicle-selector__field">
          <label
            class="vehicle-selector__label"
            for="VehicleSelectorYear-{{ section.id }}"
          >
            {{- 'vehicle_selector.year' | t -}}
          </label>
          <select
            id="VehicleSelectorYear-{{ section.id }}"
            class="field__input vehicle-selector__select"
            name="year"
            ref="year"
            on:change="/handleYearChange"
            disabled
          >
            <option value="">{{ 'vehicle_selector.choose_year' | t }}</option>
          </select>
        </div>
      </div>

      <fieldset
        class="vehicle-selector__displays"
        ref="displayFieldset"
        hidden
      >
        <legend class="vehicle-selector__label">{{ 'vehicle_selector.display' | t }}</legend>
        <p class="vehicle-selector__help">{{ 'vehicle_selector.display_help' | t }}</p>
        <div
          class="vehicle-selector__display-list"
          ref="displayList"
          on:change="/handleDisplayChange"
        ></div>
      </fieldset>

      <button
        type="submit"
        class="button vehicle-selector__submit"
        ref="submit"
        disabled
      >
        {{ 'vehicle_selector.submit' | t }}
      </button>

      <div
        class="vehicle-selector__message"
        ref="message"
        role="status"
        aria-live="polite"
      ></div>
    </form>

    <script type="application/json" ref="strings">
      {
        "chooseModel": {{ 'vehicle_selector.choose_model' | t | json }},
        "chooseYear": {{ 'vehicle_selector.choose_year' | t | json }},
        "noProduct": {{ 'vehicle_selector.no_product' | t | json }},
        "contactLink": {{ 'vehicle_selector.contact_link' | t | json }},
        "noDisplayForYear": {{ 'vehicle_selector.no_display_for_year' | t | json }}
      }
    </script>
    <script type="application/json" ref="data">
      {% render 'vehicle-selector-data' %}
    </script>
  </vehicle-selector-component>
</div>

{% stylesheet %}
  .vehicle-selector {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg, 1rem);
    width: 100%;
    max-width: 64rem;
    margin-inline: auto;
  }

  .vehicle-selector__header {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs, 0.25rem);
  }

  .vehicle-selector__heading,
  .vehicle-selector__subheading {
    margin: 0;
  }

  .vehicle-selector__form {
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg, 1rem);
  }

  .vehicle-selector__form[hidden],
  .vehicle-selector__summary[hidden],
  .vehicle-selector__displays[hidden],
  .vehicle-selector__empty[hidden] {
    display: none;
  }

  /* Mobil: Felder untereinander, ab Tablet nebeneinander */
  .vehicle-selector__fields {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-md, 0.75rem);
  }

  @media screen and (min-width: 750px) {
    .vehicle-selector__fields {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .vehicle-selector__field {
    display: flex;
    flex-direction: column;
    gap: var(--gap-2xs, 0.25rem);
  }

  .vehicle-selector__label {
    font-weight: 600;
    padding: 0;
  }

  .vehicle-selector__select {
    width: 100%;
    min-height: 44px;
    cursor: pointer;
  }

  .vehicle-selector__select:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  .vehicle-selector__select:focus-visible,
  .vehicle-selector__option:has(input:focus-visible) {
    outline: var(--focus-outline-width, 2px) solid currentcolor;
    outline-offset: var(--focus-outline-offset, 2px);
  }

  .vehicle-selector__displays {
    border: 0;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm, 0.5rem);
  }

  .vehicle-selector__help {
    margin: 0;
    opacity: 0.8;
  }

  .vehicle-selector__display-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-md, 0.75rem);
  }

  @media screen and (min-width: 750px) {
    .vehicle-selector__display-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .vehicle-selector__option {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--gap-sm, 0.5rem);
    align-items: start;
    padding: var(--padding-md, 0.75rem);
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20, 0.2));
    border-radius: var(--style-border-radius-inputs, 4px);
    cursor: pointer;
  }

  .vehicle-selector__option:has(input:checked) {
    border-color: currentcolor;
    box-shadow: 0 0 0 1px currentcolor;
  }

  .vehicle-selector__option input {
    margin-block-start: 0.25em;
    accent-color: currentcolor;
  }

  .vehicle-selector__option-body {
    display: flex;
    flex-direction: column;
    gap: var(--gap-xs, 0.25rem);
  }

  .vehicle-selector__option-hint {
    margin: 0;
    white-space: pre-line;
    font-size: 0.9em;
    opacity: 0.85;
  }

  .vehicle-selector__option-image {
    width: 100%;
    max-width: 240px;
    height: auto;
    border-radius: var(--style-border-radius-inputs, 4px);
  }

  .vehicle-selector__submit {
    align-self: flex-start;
    min-height: 44px;
  }

  @media screen and (max-width: 749px) {
    .vehicle-selector__submit {
      align-self: stretch;
    }
  }

  .vehicle-selector__message:empty {
    display: none;
  }

  .vehicle-selector__summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--gap-sm, 0.5rem) var(--gap-md, 0.75rem);
  }

  .vehicle-selector__summary-text {
    margin: 0;
  }

  .vehicle-selector__change {
    text-decoration: underline;
    min-height: 44px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:vehicle_selector.name",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:vehicle_selector.settings.heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:vehicle_selector.settings.subheading"
    },
    {
      "type": "url",
      "id": "contact_url",
      "label": "t:vehicle_selector.settings.contact_url",
      "info": "t:vehicle_selector.settings.contact_url_info"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:vehicle_selector.name",
      "category": "t:categories.forms",
      "settings": {
        "heading": "t:vehicle_selector.defaults.heading",
        "subheading": "t:vehicle_selector.defaults.subheading"
      }
    }
  ]
}
{% endschema %}
