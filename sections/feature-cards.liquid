{%- liquid
  assign layout = section.settings.layout
  assign tone = section.settings.tone
-%}

<div class="section-background feature-cards-bg feature-cards-bg--{{ tone }}"></div>
<div
  class="section section--page-width spacing-style feature-cards-section feature-cards-section--{{ tone }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="feature-cards feature-cards--{{ layout }}">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.intro != blank -%}
      <div class="feature-cards__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="feature-cards__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="feature-cards__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <p class="feature-cards__intro">{{ section.settings.intro | escape }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul
      class="feature-cards__list"
      role="list"
    >
      {%- for block in section.blocks -%}
        <li
          class="feature-cards__item{% if block.settings.highlight %} feature-cards__item--highlight{% endif %}"
          {{ block.shopify_attributes }}
        >
          {%- if layout == 'steps' -%}
            <span
              class="feature-cards__number"
              aria-hidden="true"
              >{{ forloop.index }}</span
            >
          {%- else -%}
            <span
              class="feature-cards__icon"
              aria-hidden="true"
            >
              {%- render 'feature-icon', icon: block.settings.icon -%}
            </span>
          {%- endif -%}
          <div class="feature-cards__body">
            {%- if block.settings.badge != blank -%}
              <span class="feature-cards__badge">{{ block.settings.badge | escape }}</span>
            {%- endif -%}
            {%- if block.settings.title != blank -%}
              <h3 class="feature-cards__title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="feature-cards__text">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .feature-cards-section {
    --fc-ink-rgb: 11 18 34;
    --fc-accent: var(--color-primary-button-background, #2f6bff);
    position: relative;
  }

  /* Spezifität wie Horizons .section-background-Regel, sonst gewinnt deren background-color */
  .shopify-section:not(.header-section) .section-background.feature-cards-bg--tint {
    background-color: #e8eeff;
  }

  .shopify-section:not(.header-section) .section-background.feature-cards-bg--white {
    background-color: #fff;
  }

  .shopify-section:not(.header-section) .section-background.feature-cards-bg--dark {
    background-color: #0b1222;
    background-image: radial-gradient(700px 400px at 100% 0%, rgb(47 107 255 / 0.25), transparent 60%);
  }

  .feature-cards-section--dark {
    --fc-ink-rgb: 255 255 255;
    color: #fff;
  }

  .feature-cards {
    display: flex;
    flex-direction: column;
    gap: clamp(1.5rem, 1rem + 2vw, 2.75rem);
    width: 100%;
  }

  .feature-cards__header {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 40rem;
  }

  .feature-cards__eyebrow {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fc-accent);
  }

  .feature-cards-section--dark .feature-cards__eyebrow {
    color: #8fb0ff;
  }

  .feature-cards__heading {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: clamp(1.75rem, 1.2rem + 2vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
    color: inherit;
  }

  .feature-cards__intro {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: rgb(var(--fc-ink-rgb) / 0.72);
  }

  .feature-cards__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .feature-cards__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .feature-cards--steps .feature-cards__list,
    .feature-cards--cards .feature-cards__list {
      grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
      gap: 1.25rem;
    }
  }

  @media screen and (min-width: 990px) {
    .feature-cards--usp .feature-cards__list {
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    }
  }

  .feature-cards__item {
    position: relative;
    display: flex;
    gap: 1rem;
  }

  /* USP-Leiste: kompakt, Icon links */
  .feature-cards--usp .feature-cards__item {
    align-items: center;
  }

  .feature-cards--usp .feature-cards__title {
    font-size: 1rem;
  }

  .feature-cards--usp .feature-cards__text {
    font-size: 0.875rem;
  }

  /* Karten & Schritte */
  .feature-cards--cards .feature-cards__item,
  .feature-cards--steps .feature-cards__item {
    flex-direction: column;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border-radius: 18px;
    background: #fff;
    border: 1px solid rgb(11 18 34 / 0.08);
    box-shadow: 0 1px 2px rgb(11 18 34 / 0.04), 0 10px 30px rgb(11 18 34 / 0.05);
    color: #0b1222;
    --fc-ink-rgb: 11 18 34;
  }

  .feature-cards-section--dark .feature-cards--cards .feature-cards__item,
  .feature-cards-section--dark .feature-cards--steps .feature-cards__item {
    background: rgb(255 255 255 / 0.05);
    border-color: rgb(255 255 255 / 0.1);
    box-shadow: none;
    color: #fff;
    --fc-ink-rgb: 255 255 255;
  }

  .feature-cards__item--highlight {
    border-color: var(--fc-accent) !important;
    box-shadow: 0 0 0 1px var(--fc-accent), 0 18px 40px rgb(47 107 255 / 0.15) !important;
  }

  .feature-cards__icon {
    display: inline-grid;
    place-items: center;
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    border-radius: 14px;
    background: rgb(47 107 255 / 0.1);
    color: var(--fc-accent);
  }

  .feature-cards-section--dark .feature-cards__icon {
    background: rgb(47 107 255 / 0.2);
    color: #8fb0ff;
  }

  .feature-cards__icon svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .feature-cards__number {
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--fc-accent);
    color: #fff;
    font-family: var(--font-heading--family);
    font-weight: 700;
    font-size: 1.125rem;
  }

  .feature-cards__body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .feature-cards__badge {
    align-self: flex-start;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: var(--fc-accent);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .feature-cards__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-weight: var(--font-heading--weight);
    font-size: 1.1875rem;
    letter-spacing: -0.01em;
    color: inherit;
  }

  .feature-cards__text {
    font-size: 0.9375rem;
    line-height: 1.55;
    color: rgb(var(--fc-ink-rgb) / 0.72);
  }

  .feature-cards__text > * {
    margin: 0;
  }

  .feature-cards__text > * + * {
    margin-top: 0.5rem;
  }

  .feature-cards__text ul {
    padding-inline-start: 1.1rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:custom_sections.feature_cards.name",
  "max_blocks": 8,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "t:custom_sections.feature_cards.layout",
      "options": [
        {
          "value": "usp",
          "label": "t:custom_sections.feature_cards.layout_usp"
        },
        {
          "value": "cards",
          "label": "t:custom_sections.feature_cards.layout_cards"
        },
        {
          "value": "steps",
          "label": "t:custom_sections.feature_cards.layout_steps"
        }
      ],
      "default": "cards"
    },
    {
      "type": "select",
      "id": "tone",
      "label": "t:custom_sections.feature_cards.tone",
      "options": [
        {
          "value": "default",
          "label": "t:custom_sections.feature_cards.tone_default"
        },
        {
          "value": "white",
          "label": "t:custom_sections.feature_cards.tone_white"
        },
        {
          "value": "tint",
          "label": "t:custom_sections.feature_cards.tone_tint"
        },
        {
          "value": "dark",
          "label": "t:custom_sections.feature_cards.tone_dark"
        }
      ],
      "default": "default"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:custom_sections.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:custom_sections.heading"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "t:custom_sections.intro"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "t:custom_sections.feature_cards.block",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:custom_sections.feature_cards.icon",
          "options": [
            { "value": "target", "label": "t:custom_sections.icons.target" },
            { "value": "sparkle", "label": "t:custom_sections.icons.sparkle" },
            { "value": "truck", "label": "t:custom_sections.icons.truck" },
            { "value": "shield", "label": "t:custom_sections.icons.shield" },
            { "value": "car", "label": "t:custom_sections.icons.car" },
            { "value": "sun", "label": "t:custom_sections.icons.sun" },
            { "value": "tool", "label": "t:custom_sections.icons.tool" },
            { "value": "return", "label": "t:custom_sections.icons.return" }
          ],
          "default": "target"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "t:custom_sections.feature_cards.badge"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:custom_sections.feature_cards.title"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "t:custom_sections.feature_cards.text"
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "label": "t:custom_sections.feature_cards.highlight",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:custom_sections.feature_cards.name",
      "category": "t:categories.text",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
