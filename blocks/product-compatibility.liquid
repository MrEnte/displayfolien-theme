{%- doc -%}
  Zeigt die Fahrzeuge/Displays aus dem Produkt-Metafeld custom.kompatible_displays.
  Nur Displayausführungen mit passform_bestaetigt = true werden angezeigt.
{%- enddoc -%}

{%- liquid
  assign displays = closest.product.metafields.custom.kompatible_displays.value
  assign confirmed_count = 0
  for display in displays
    if display.passform_bestaetigt.value == true
      assign confirmed_count = confirmed_count | plus: 1
    endif
  endfor
-%}

<div
  class="product-compatibility"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.heading != blank -%}
    <p class="product-compatibility__heading">{{ block.settings.heading | escape }}</p>
  {%- endif -%}

  {%- if confirmed_count > 0 -%}
    <ul
      class="product-compatibility__list"
      role="list"
    >
      {%- for display in displays -%}
        {%- liquid
          unless display.passform_bestaetigt.value == true
            continue
          endunless

          assign series = display.baureihe.value
          assign model = series.modell.value
          assign brand = model.marke.value
        -%}
        <li class="product-compatibility__item">
          {%- liquid
            assign year_to = series.baujahr_bis.value
            if year_to == blank
              assign year_to = 'product_fit.until_today' | t
            endif
          -%}
          <span class="product-compatibility__vehicle">
            {{- brand.name.value }} {{ model.name.value }} – {{ series.name.value }} ({{ series.baujahr_von.value }}–{{ year_to }})
          </span>
          <span class="product-compatibility__display">
            {{- 'product_fit.display' | t }}: {{ display.name.value -}}
          </span>
          {%- if block.settings.show_hint and display.erkennungshinweis.value != blank -%}
            <span class="product-compatibility__hint">
              {{- display.erkennungshinweis.value | escape | newline_to_br -}}
            </span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <p class="product-compatibility__empty">{{ 'product_fit.none' | t }}</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .product-compatibility {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm, 0.5rem);
    width: 100%;
  }

  .product-compatibility__heading {
    margin: 0;
    font-weight: 600;
  }

  .product-compatibility__list {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm, 0.5rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-compatibility__item {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    padding-inline-start: 1.25em;
    position: relative;
  }

  .product-compatibility__item::before {
    content: '✓';
    position: absolute;
    inset-inline-start: 0;
    font-weight: 700;
  }

  .product-compatibility__vehicle {
    font-weight: 600;
  }

  .product-compatibility__hint {
    font-size: 0.9em;
    opacity: 0.8;
  }

  .product-compatibility__empty {
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:product_fit.compatibility.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:product_fit.compatibility.heading"
    },
    {
      "type": "checkbox",
      "id": "show_hint",
      "label": "t:product_fit.compatibility.show_hint",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:product_fit.compatibility.name",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
